{
  "name": "nova-launcher-build",
  "version": "0.1.7",
  "private": true,
  "scripts": {
    "start": "electron app",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test": "node tests/release.cjs && node tests/localization.cjs && node tests/profile-boot.cjs && node tests/web-sync.cjs && node tests/updates.cjs && node tests/artwork.cjs && node tests/personal-profile.cjs",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "^30.1.3"
  },
  "build": {
    "appId": "Nova.Launcher",
    "productName": "Nova Launcher",
    "directories": {
      "app": "app",
      "output": "dist"
    },
    "asar": true,
    "files": [
      "**/*",
      "!**/data/**",
      "!**/*.log"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/assets/NOVA.ico",
      "artifactName": "nova-launcher-v${version}.exe",
      "signExecutable": false,
      "extraFiles": [
        {
          "from": "tools",
          "to": "tools",
          "filter": [
            "**/*",
            "!**/*.pdb"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nova Launcher",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "it_IT"
      ],
      "installerIcon": "app/assets/NOVA.ico",
      "uninstallerIcon": "app/assets/NOVA.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "app/assets/NOVA.png",
      "artifactName": "nova-launcher-v${version}-linux-${arch}.AppImage",
      "extraFiles": [],
      "executableName": "nova-launcher",
      "desktop": {
        "entry": {
          "Name": "Nova Launcher",
          "Comment": "Nova Launcher Linux preview"
        }
      }
    }
  }
}
